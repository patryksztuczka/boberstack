{
  "name": "@boberstack/mobile",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy baseLocale --emit-ts-declarations && uniwind generate-artifacts --css ./global.css --dts ./uniwind-types.d.ts",
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build": "expo export --platform ios --platform android --output-dir dist --clear",
    "test": "vp test"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.14",
    "@boberstack/client-runtime": "workspace:*",
    "@boberstack/domain": "workspace:*",
    "@boberstack/ui": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "better-auth": "catalog:",
    "effect": "catalog:",
    "expo": "58.0.23",
    "expo-constants": "58.0.15",
    "expo-dev-client": "58.0.18",
    "expo-haptics": "58.0.7",
    "expo-linking": "58.0.16",
    "expo-network": "58.0.4",
    "expo-secure-store": "58.0.2",
    "expo-sensors": "58.0.4",
    "expo-splash-screen": "58.0.13",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "expo-updates": "58.0.21",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "uniwind": "1.13.2"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@inlang/paraglide-js": "2.29.3",
    "@types/react": "catalog:",
    "tailwindcss": "4.3.3",
    "vite-plus": "catalog:"
  }
}
