{
  "name": "@boberstack/infra",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @boberstack/api run dev",
    "deploy": "varlock run --path ../.. -- alchemy deploy --env-file /dev/null",
    "destroy": "varlock run --path ../.. -- alchemy destroy --env-file /dev/null",
    "dev:cloudflare": "varlock run --path ../.. -- alchemy dev cloudflare.run.ts --env-file /dev/null",
    "deploy:cloudflare": "varlock run --path ../.. -- alchemy deploy cloudflare.run.ts --env-file /dev/null",
    "destroy:cloudflare": "varlock run --path ../.. -- alchemy destroy cloudflare.run.ts --env-file /dev/null"
  },
  "dependencies": {
    "@alchemy.run/better-auth": "catalog:",
    "@alchemy.run/cloudflare": "catalog:",
    "@alchemy.run/docker": "catalog:",
    "@alchemy.run/sql": "catalog:",
    "@boberstack/api": "workspace:*",
    "@boberstack/auth": "workspace:*",
    "@boberstack/capability": "workspace:*",
    "alchemy": "catalog:",
    "effect": "catalog:"
  }
}
