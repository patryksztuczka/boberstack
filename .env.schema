# Every variable the api Worker and the CLI read through Effect Config, plus the dev ports. Checked in, never holds a secret.
# Put local values in .env.local (gitignored); `pnpm dev` sets the dev ports and URLs itself.
# Defaults live in code (Config.withDefault); this file declares names, types, what is sensitive
# and what production requires. `pnpm env:check` validates the current environment against it.
#
# @currentEnv=$APP_ENV
# @defaultRequired=false
# @defaultSensitive=false
# ---

# Which environment files load: .env.production and .env.production.local for a deploy.
# @type=enum(development, production)
APP_ENV=development

# Ports of this checkout's dev stack. `pnpm dev` derives them from the checkout path; set one to override it.
# @type=port
DEV_WEB_PORT=
# @type=port
DEV_API_PORT=
# @type=port
DEV_POSTGRES_PORT=
# @type=port
DEV_MAILPIT_PORT=
# @type=port
DEV_METRO_PORT=

# Postgres for `alchemy dev` and `pnpm cli db migrate`. A deploy migrates it and reaches it through Hyperdrive.
# @sensitive
# @required=forEnv(production)
DATABASE_URL=

# Origin better-auth builds links from, such as the web app's URL.
# @type=url
AUTH_BASE_URL=

# Extra origins better-auth accepts, comma-separated.
AUTH_TRUSTED_ORIGINS=

# How the api sends mail. Mailpit is the only transport so far (root ADR 0008).
# @type=enum(mailpit)
# @required=forEnv(production)
MAIL_TRANSPORT=

# @type=url
MAILPIT_URL=

# @type=email
MAIL_FROM_EMAIL=

MAIL_FROM_NAME=

# GitHub sign-in. Without both, the button does not appear.
GITHUB_CLIENT_ID=
# @sensitive
GITHUB_CLIENT_SECRET=

# Google sign-in. Without both, the button does not appear.
GOOGLE_CLIENT_ID=
# @sensitive
GOOGLE_CLIENT_SECRET=

# The desktop app (apps/desktop). `pnpm dev:desktop` sets DESKTOP_RENDERER_URL and DESKTOP_USER_DATA_DIR.
# Dev server the window opens; without it the window serves apps/web/dist itself.
# @type=url
DESKTOP_RENDERER_URL=

# Origin of the deployed app the window takes the place of when it serves apps/web/dist; /api goes there.
# @type=url
DESKTOP_APP_URL=

# Where the desktop app keeps its cookies, cache and single-instance lock; one per checkout in development.
DESKTOP_USER_DATA_DIR=

# The mobile app (apps/mobile). `pnpm dev:mobile` sets both; an EAS build profile sets APP_VARIANT.
# Which build of the app: its name, bundle id and URL scheme. Unset means production.
# @type=enum(development, preview, production)
APP_VARIANT=

# Origin of the api the app talks to, such as the deployed app's URL. Expo builds it into the bundle.
# @type=url
EXPO_PUBLIC_API_URL=
